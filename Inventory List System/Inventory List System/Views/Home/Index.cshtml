@model List<Inventory_List_System.Models.Database.InventoryItem>

@{
    ViewBag.Title = "Inventory";

   
    int totalItems = ViewBag.TotalItems ?? 0;
    int pageSize = ViewBag.PageSize ?? 10;
    int page = ViewBag.Page ?? 1;
    string search = ViewBag.Search ?? "";

    int totalPages = (int)Math.Ceiling((double)totalItems / pageSize);
}

<h2>My Inventory</h2>

<form method="get" class="mb-3">
    <input name="search" value="@search" class="form-control" placeholder="Search item" />
</form>


<button class="btn btn-primary mb-3" data-bs-toggle="modal" data-bs-target="#addModal">
    Add Item
</button>


<table class="table table-striped">
    <thead>
        <tr>
            <th>Item Name</th>
            <th>Quantity</th>
            <th>Price</th>
            <th>Date Added</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Count > 0)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.ItemName</td>
                    <td>@item.Quantity</td>
                    <td>@item.Price.ToString("C")</td>
                    <td>@item.DateAdded.ToString("yyyy-MM-dd")</td>
                    <td>
                        <!-- Delete form -->
                        <form method="post" asp-action="Delete" class="d-inline">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center">No Items Available</td>
            </tr>
        }
    </tbody>
</table>


@if (totalPages > 1)
{
    <nav>
        <ul class="pagination">
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == page ? "active" : "")">
                    <a class="page-link" href="?page=@i&search=@search">@i</a>
                </li>
            }
        </ul>
    </nav>
}


<div class="modal fade" id="addModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="Create">
                <div class="modal-header">
                    <h5>Add Item</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input name="itemName" class="form-control mb-2" placeholder="Item Name" required />
                    <input name="quantity" type="number" class="form-control mb-2" placeholder="Quantity" required />
                    <input name="price" type="number" step="0.01" class="form-control mb-2" placeholder="Price" required />
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary" type="submit">Save</button>
                    <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>